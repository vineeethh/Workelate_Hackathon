# ---- LLM (optional). Used for intent parsing + grounded summaries.
# Without a key CrawlPilot still works end-to-end (rule-based intent + extractive summary).
# Provider: openrouter | anthropic
LLM_PROVIDER=openrouter

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Or direct Anthropic API
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# auto | off   (off forces rules mode even if a key is present)
USE_LLM=auto
# Hard wall-clock limit for one CLI run (seconds)
CLI_TIMEOUT_S=90
